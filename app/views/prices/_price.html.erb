<%# locals: (price:, observed_at: nil, trade_id: nil) %>
<%
  observed = observed_at || price.created_at
  observed_ms = observed ? (observed.to_r * 1000).to_i : nil
%>
<tr
  id="price_<%= price.persisted? ? price.id : SecureRandom.hex(8) %>"
  class="even:bg-gray-50"
  data-binance-time="<%= (price.binance_time.to_r * 1000).to_i %>"
  data-price="<%= price.price %>"
  <% if observed_ms %>data-observed-at="<%= observed_ms %>"<% end %>
  <% if trade_id %>data-trade-id="<%= trade_id %>"<% end %>
>
  <td class="px-4 py-3 font-mono text-sm font-semibold text-gray-900"><%= price.symbol %></td>
  <td class="px-4 py-3 text-right font-mono text-sm text-gray-900">
    <%= number_to_currency(price.price, precision: 2) %>
  </td>
  <td class="px-4 py-3 text-sm text-gray-700">
    <%= price.binance_time&.strftime("%H:%M:%S.%L") %>
  </td>
  <td class="px-4 py-3 text-sm text-gray-700">
    <%= observed&.strftime("%H:%M:%S.%L") %>
    <% if observed && price.binance_time %>
      <p class="text-xs text-gray-500">
        Latency <b><%= ((observed - price.binance_time) * 1000).round(1) %></b> ms
      </p>
    <% end %>
  </td>
</tr>
