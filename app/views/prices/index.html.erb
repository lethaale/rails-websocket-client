<div class="w-full space-y-4">
  <header class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <img src="/icon-512.png" alt="" class="h-28 w-28 shrink-0 rounded-lg" width="112" height="112">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-gray-900">Rails Is The Client — latency comparison</h1>
        <p class="text-sm text-gray-600">
          Same Binance feed, two paths. Stats are computed entirely in your browser.
        </p>
        <p class="text-xs text-amber-700">
          ⚠️ Latency is captured at different points: <b>Rails</b> records it server-side (inside the job, before the Turbo Stream is broadcast), while <b>JS Direct</b> records it in the browser. When both feeds share the same tab, the browser main thread can be busy rendering rows from <i>both</i> sides, which delays JS Direct's timestamp but not Rails'. That can make Rails look faster than it really is.
        </p>
        <p class="text-sm text-gray-500">
          Binance's <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">stream.binance.com</code> is hosted in Tokyo, so the further you (or the Rails region) are from <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">nrt</code>, the more both paths inherit that round-trip.
        </p>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-900 px-3 py-1 text-xs font-mono uppercase tracking-wide text-white">
      region: <%= ENV.fetch("REGION", "local") %>
      <%= render "info_icon", text: "Which deployment served this page. Set via the REGION env var per Kamal destination. 'local' means you're running it on your machine." %>
    </span>
  </header>

  <%= render "comparison" %>

  <div
    data-controller="price-match"
    class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-3 shadow-sm"
  >
    <div class="flex items-center gap-2">
      <span data-price-match-target="flag" class="inline-block h-3 w-3 rounded-full bg-gray-300"></span>
      <span data-price-match-target="label" class="text-sm font-semibold text-gray-500">Waiting for both feeds</span>
      <%= render "info_icon", text: "Green when JS Direct and Rails currently show the same last price; red when they differ. The divergence % is the share of 1-second samples (since both feeds came online) where the two prices weren't equal." %>
    </div>
    <div class="flex items-center gap-4 text-xs font-mono uppercase tracking-wide text-gray-500">
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded bg-emerald-500"></span>
        <span data-price-match-target="directPrice" class="tabular-nums text-gray-700">--</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded bg-indigo-500"></span>
        <span data-price-match-target="railsPrice" class="tabular-nums text-gray-700">--</span>
      </span>
      <span class="flex items-center gap-1.5">
        delta
        <span data-price-match-target="delta" class="tabular-nums text-gray-500">--</span>
      </span>
      <span class="flex items-center gap-1.5">
        diverged
        <span data-price-match-target="divergence" class="tabular-nums text-gray-700">--</span>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <%# Left: JS Direct %>
    <section
      data-controller="direct-feed"
      data-direct-feed-url-value="wss://stream.binance.com:9443/ws/btcusdt@trade"
      class="space-y-3"
    >
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
          JS Direct
          <span class="text-xs font-normal text-gray-500">browser → Binance</span>
          <span
            class="ml-1 rounded-md bg-emerald-50 px-2 py-0.5 font-mono text-base text-emerald-700 tabular-nums"
            data-direct-feed-target="currentPrice"
          >--</span>
          <%= render "info_icon", text: "Pure-JS path: this browser tab opens a WebSocket straight to Binance. No Rails, no server round-trip on the data path. The baseline." %>
        </h2>
        <span
          class="text-xs font-mono uppercase tracking-wide text-gray-500"
          data-direct-feed-target="status"
        >connecting</span>
      </div>
      <%= render "stats_panel", controller: "direct-feed", show_drop_rate: true, show_binance_internal: true, show_same_price: true %>
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="overflow-y-auto max-h-[60vh]" data-direct-feed-target="viewport">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Symbol</th>
                <th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Price</th>
                <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Binance time</th>
                <th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Observed at</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100" data-direct-feed-target="content"></tbody>
          </table>
        </div>
      </div>
    </section>

    <%# Right: Rails path %>
    <section data-controller="rails-feed" class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
          Rails
          <span class="text-xs font-normal text-gray-500">Go → Solid Queue → Active Job → Turbo Stream</span>
          <span
            class="ml-1 rounded-md bg-indigo-50 px-2 py-0.5 font-mono text-base text-indigo-700 tabular-nums"
            data-rails-feed-target="currentPrice"
          >--</span>
          <%= render "info_icon", text: "Rails path: a Go process holds the WebSocket and writes Active Job rows directly into Solid Queue's SQLite tables. Rails picks them up, broadcasts via Turbo Stream, and your browser renders the row." %>
        </h2>
      </div>
      <%= turbo_stream_from "prices" %>
      <%= render "stats_panel", controller: "rails-feed", show_drop_rate: true %>
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="overflow-y-auto max-h-[60vh]" data-rails-feed-target="viewport">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Symbol</th>
                <th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Price</th>
                <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Binance time</th>
                <th class="px-4 py-2 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Observed at</th>
              </tr>
            </thead>
            <tbody
              id="prices-list"
              class="divide-y divide-gray-100"
              data-rails-feed-target="content"
            >
              <%= render @prices %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</div>
