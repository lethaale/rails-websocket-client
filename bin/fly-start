#!/bin/bash
# Fly.io launcher: runs Rails and the Go listener on a single Machine. Both
# processes write to the same Postgres database (DATABASE_URL is injected by
# Fly's Supabase add-on). Rails boots first; the listener only starts once the
# /up health endpoint is responding, mostly so a clean DB has tables ready
# before the Go writer hits it.
set -e

# Standard Rails multi-database prepare — creates / loads schema for primary,
# queue, cable, and cache against their respective DATABASE_URL secrets.
./bin/rails db:prepare

# In a subshell, wait until Rails is accepting requests, then exec the
# listener. With Postgres there's no longer a write-lock contention issue, but
# we keep the gate so the listener never starts before the schema is in place.
# Rails stays in the foreground; if it crashes Fly restarts the Machine.
# If the listener dies, Rails keeps running — restart it via `fly machine restart`.
(
  health_url="http://127.0.0.1:${HTTP_PORT:-8080}/up"
  for attempt in $(seq 1 60); do
    if curl --fail --silent --show-error --max-time 1 "$health_url" > /dev/null 2>&1; then
      echo "[fly-start] Rails healthy after ${attempt}s, starting listener"
      exec /usr/local/bin/listener
    fi
    sleep 1
  done
  echo "[fly-start] Rails health probe timed out after 60s, listener not started" >&2
) &

# Rails in the foreground — its lifecycle drives the Machine.
# Bind to 0.0.0.0 explicitly so Fly's proxy can reach us; skip Thruster on
# this path (Fly's edge already does HTTPS termination and HTTP/2).
exec ./bin/rails server -b 0.0.0.0 -p "${HTTP_PORT:-8080}"
